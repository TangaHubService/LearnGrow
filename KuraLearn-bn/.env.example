NODE_ENV=development
APP_ENV=development
PORT=4000
DATABASE_URL="postgresql://kuralearn:kuralearn@localhost:5432/kuralearn?schema=public"
JWT_SECRET="replace-with-a-long-random-secret-at-least-24-characters"
OPENAI_API_KEY=""
OPENAI_MODEL=gpt-5.5
OPENAI_FAST_MODEL=gpt-5.4-mini
API_BASE_URL="http://localhost:4000/api/v1"
WEB_ORIGIN="http://localhost:5173,http://localhost:5174"
MOBILE_ORIGIN="exp://localhost:8081"


# Backend .env configuration
STORAGE_PROVIDER=CLOUDINARY
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
# Backend .env configuration
STORAGE_PROVIDER=LOCAL

# Google Drive Storage Integration
# Set STORAGE_PROVIDER=GOOGLE_DRIVE to enable
GOOGLE_SERVICE_ACCOUNT_EMAIL="your-service-account@your-project-id.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_FOLDER_ID="your-shared-folder-alphanumeric-id-here"

# Frontend URL
FRONTEND_URL="http://localhost:5173"

# SMTP Settings (optional — emails log to console if unset)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="KuraLearn <noreply@kuralearn.com>"
SMTP_SECURE="false"

