generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String         @id @default(uuid())
  name             String
  email            String         @unique
  passwordHash     String
  role             UserRole
  status           UserStatus     @default(ACTIVE)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  lastLoginAt      DateTime?
  aiUsageLogs      AIUsageLog[]
  passwordResetTokens PasswordResetToken[]
  receivedMessages Message[]      @relation("ReceivedMessages")
  sentMessages     Message[]      @relation("SentMessages")
  notifications    Notification[]
  parent           Parent?
  student          Student?
  teacher          Teacher?
  teacherResources TeacherResource[]
  markAuditLogs    MarkAuditLog[]
  reviewedMarks    Mark[]                @relation("MarkReviewer")
  reviewedMarkSubmissions MarkSubmission[] @relation("MarkSubmissionReviewer")
  markSubmissionEvents MarkSubmissionEvent[]
  approvedReportCards ReportCard[]       @relation("ReportCardApprover")
  staff            Staff?
  invitedStaff     Staff[]        @relation("StaffInviter")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Staff {
  id               String           @id @default(uuid())
  userId           String           @unique
  schoolId         String?
  staffRole        StaffRole
  phone            String?
  gender           Gender?
  employmentStatus EmploymentStatus @default(PERMANENT)
  invitationStatus InvitationStatus @default(PENDING)
  invitationToken  String?
  invitationSentAt DateTime?
  invitedById      String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  school           School?          @relation(fields: [schoolId], references: [id])
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments      StaffAssignment[]
  invitedBy        User?            @relation("StaffInviter", fields: [invitedById], references: [id])

  @@index([schoolId])
  @@index([staffRole])
  @@index([invitationStatus])
}

model StaffAssignment {
  id             String       @id @default(uuid())
  staffId        String
  classId        String?
  subjectId      String?
  subjectName    String?
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  staff          Staff        @relation(fields: [staffId], references: [id], onDelete: Cascade)
  class          Class?       @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject        Subject?     @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([staffId, classId, subjectName])
  @@index([staffId])
}

enum StaffRole {
  HEADTEACHER
  SCHOOL_ADMIN
  DIRECTOR_OF_STUDIES
  TEACHER
  ACCOUNTANT
  DISCIPLINE_OFFICER
  LIBRARIAN
  ICT_OFFICER
  RECEPTIONIST
  SUPPORT_STAFF
}

enum EmploymentStatus {
  PERMANENT
  CONTRACT
  PART_TIME
  INTERN
  VOLUNTEER
}

enum InvitationStatus {
  PENDING
  SENT
  ACCEPTED
  EXPIRED
}

model Student {
  id                      String                 @id @default(uuid())
  userId                  String                 @unique
  schoolId                String?
  levelId                 String
  classId                 String?
  dateOfBirth             DateTime?
  avatar                  String?
  language                String                 @default("en")
  interests               String[]               @default([])
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  admissionDate           DateTime?
  birthCertificateNumber  String?
  boardingStatus          String?
  cell                    String?
  disabilityType          String?
  district                String?
  gender                  Gender?
  hasDisability           Boolean                @default(false)
  inclusiveEducationNotes String?
  medicalNotes            String?
  nationalId              String?
  nationality             String                 @default("Rwandan")
  pathway                 EducationPathway?
  previousSchool          String?
  province                String?
  sector                  String?
  specialSupportNeeds     String?
  status                  StudentStatus          @default(ACTIVE)
  stream                  String?
  studentCode             String?                @unique
  village                 String?
  combinationId           String?
  conversations           AIConversation[]
  assessmentSubmissions   AssessmentSubmission[]
  assignmentSubmissions   AssignmentSubmission[]
  attendanceAlerts        AttendanceAlert[]
  attendanceRecords       AttendanceRecord[]
  certificates            Certificate[]
  courseEnrollments       CourseEnrollment[]
  goals                   Goal[]
  lessonProgress          LessonProgress[]
  quizAttempts            QuizAttempt[]
  class                   Class?                 @relation(fields: [classId], references: [id])
  combination             SecondaryCombination?  @relation(fields: [combinationId], references: [id])
  level                   Level                  @relation(fields: [levelId], references: [id])
  school                  School?                @relation(fields: [schoolId], references: [id])
  user                    User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  badges                  StudentBadge[]
  parents                 StudentParent[]
  promotions              StudentPromotion[]
  riskScore               StudentRiskScore?
  transfers               StudentTransfer[]
  learnerSupportPlans     LearnerSupportPlan[]
  academicPathways        StudentAcademicPathway[]
  nationalExamRegistrations NationalExamRegistration[]
  nationalExamResults     NationalExamResult[]
  marks                   Mark[]
  reportCards             ReportCard[]

  @@index([combinationId])
  @@index([pathway])
}

model Parent {
  id                     String          @id @default(uuid())
  userId                 String          @unique
  phone                  String?
  relationship           String?
  notificationPreference String          @default("email")
  cell                   String?
  district               String?
  nationalId             String?         @db.VarChar(16)
  occupation             String?
  province               String?
  sector                 String?
  village                String?
  user                   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  students               StudentParent[]
}

model StudentParent {
  id                 String  @id @default(uuid())
  studentId          String
  parentId           String
  relationship       String?
  canViewReports     Boolean @default(true)
  isEmergencyContact Boolean @default(false)
  parent             Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student            Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, parentId])
}

model Teacher {
  id                  String               @id @default(uuid())
  userId              String               @unique
  schoolId            String?
  assessments         Assessment[]
  attendanceRecords   AttendanceRecord[]
  courses             Course[]
  lessons             Lesson[]
  quizzes             Quiz[]
  lessonPlans         LessonPlan[]
  learnerSupportPlans LearnerSupportPlan[] @relation("SupportPlanCoordinator")
  timetablePeriods    TimetablePeriod[]
  submissionFeedbacks SubmissionFeedback[]
  school              School?              @relation(fields: [schoolId], references: [id])
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  marks               Mark[]
  markSubmissions     MarkSubmission[]
  workload            TeacherWorkload[]
}

model School {
  id                 String             @id @default(uuid())
  name               String
  district           String?
  type               SchoolType         @default(PUBLIC)
  subscriptionStatus SubscriptionStatus @default(TRIAL)
  logoUrl            String?
  phone              String?
  email              String?
  reportBranding     Json?
  cell               String?
  province           String?
  sector             String?
  village            String?
  academicYears      AcademicYear[]
  assessments        Assessment[]
  attendanceRecords  AttendanceRecord[]
  classes            Class[]
  courses            Course[]
  lessons            Lesson[]
  quizzes            Quiz[]
  students           Student[]
  promotions         StudentPromotion[]
  teachers           Teacher[]
  teacherResources   TeacherResource[]
  gradingScales      GradingScale[]
  marks              Mark[]
  markSubmissions    MarkSubmission[]
  staff              Staff[]
  secondaryCombinations SecondaryCombination[]
  timetablePeriods  TimetablePeriod[]
  rooms             Room[]
  periods           Period[]
  teacherWorkloads  TeacherWorkload[]
  learnerSupportPlans LearnerSupportPlan[]
  academicPathways  StudentAcademicPathway[]
  nationalExamRegistrations NationalExamRegistration[]
}

model Class {
  id                String             @id @default(uuid())
  schoolId          String
  levelId           String
  name              String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  assessments       Assessment[]
  attendanceRecords AttendanceRecord[]
  level             Level              @relation(fields: [levelId], references: [id])
  school            School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  lessons           Lesson[]
  quizzes           Quiz[]
  lessonPlans       LessonPlan[]
  students          Student[]
  teacherResources  TeacherResource[]
  marks             Mark[]
  markSubmissions   MarkSubmission[]
  reportCards       ReportCard[]
  staffAssignments  StaffAssignment[]
  timetablePeriods  TimetablePeriod[]
  academicPathways  StudentAcademicPathway[]
  nationalExamRegistrations NationalExamRegistration[]

  @@unique([schoolId, name])
}

model Level {
  id        String            @id @default(uuid())
  name      String            @unique
  category  LevelCategory
  ageRange  String
  order     Int               @unique
  classes   Class[]
  courses   Course[]
  resources LibraryResource[]
  students  Student[]
  subjects  Subject[]
  academicPathways StudentAcademicPathway[]
}

model Subject {
  id                String             @id @default(uuid())
  levelId           String
  name              String
  description       String
  icon              String
  order             Int
  category          SubjectCategory    @default(CORE)
  rebCode           String?
  isNationalExamSubject Boolean        @default(false)
  periodsPerWeek    Int?
  assessments       Assessment[]
  attendanceRecords AttendanceRecord[]
  courses           Course[]
  lessonPlans       LessonPlan[]
  resources         LibraryResource[]
  level             Level              @relation(fields: [levelId], references: [id], onDelete: Cascade)
  teacherResources  TeacherResource[]
  marks             Mark[]
  markSubmissions   MarkSubmission[]
  staffAssignments  StaffAssignment[]
  combinationSubjects CombinationSubject[]
  timetablePeriods  TimetablePeriod[]
  nationalExamResults NationalExamResult[]

  @@unique([levelId, name])
  @@index([category])
  @@index([isNationalExamSubject])
}

model Course {
  id                 String             @id @default(uuid())
  subjectId          String
  title              String
  description        String
  levelId            String
  order              Int                @default(0)
  academicYear       String?
  coverImage         String?
  createdAt          DateTime           @default(now())
  language           String?
  learningObjectives String?
  schoolId           String?
  teacherId          String?
  term               String?
  updatedAt          DateTime           @updatedAt
  status             ContentStatus      @default(DRAFT)
  activities         Activity[]
  assessments        Assessment[]
  assignments        Assignment[]
  certificates       Certificate[]
  level              Level              @relation(fields: [levelId], references: [id])
  school             School?            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subject            Subject            @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher            Teacher?           @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  enrollments        CourseEnrollment[]
  lessons            Lesson[]
  quizzes            Quiz[]
  units              Unit[]
  teacherResources   TeacherResource[]

  @@unique([subjectId, title])
}

model Unit {
  id                  String       @id @default(uuid())
  courseId            String
  title               String
  description         String?
  order               Int          @default(0)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  crossCuttingIssues  String[]     @default([])
  genericCompetencies String[]     @default([])
  isOfflineFriendly   Boolean      @default(false)
  keyCompetence       String?
  assessments         Assessment[]
  lessons             Lesson[]
  course              Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, order])
}

model CourseEnrollment {
  id              String    @id @default(uuid())
  courseId        String
  studentId       String
  enrolledAt      DateTime  @default(now())
  completedAt     DateTime?
  progressPercent Int       @default(0)
  lastAccessedAt  DateTime?
  course          Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student         Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([courseId, studentId])
}

model Lesson {
  id                  String                         @id @default(uuid())
  courseId            String
  title               String
  contentType         ContentType                    @default(MIXED)
  body                String                         @default("")
  mediaUrl            String?
  order               Int                            @default(0)
  estimatedMinutes    Int                            @default(10)
  attachments         String[]                       @default([])
  audioUrl            String?
  createdAt           DateTime                       @default(now())
  description         String?
  homework            String?
  images              String[]                       @default([])
  notes               String?
  unitId              String?
  updatedAt           DateTime                       @updatedAt
  videoUrl            String?
  classId             String?
  publishedAt         DateTime?
  scheduledAt         DateTime?
  schoolId            String?
  teacherId           String?
  assessmentCriteria  String?
  crossCuttingIssues  String[]                       @default([])
  genericCompetencies String[]                       @default([])
  isOfflineFriendly   Boolean                        @default(false)
  learnerActivities   String?
  learningObjectives  String?
  teacherActivities   String?
  topic               String?
  status              ContentStatus                  @default(DRAFT)
  linkedLessonPlanId  String?
  linkedLessonPlan    LessonPlan?                    @relation(fields: [linkedLessonPlanId], references: [id], onDelete: SetNull)
  aiMessages          AIMessage[]
  activities          Activity[]
  assessments         Assessment[]
  assignments         Assignment[]
  attendanceRecords   AttendanceRecord[]
  class               Class?                         @relation(fields: [classId], references: [id])
  course              Course                         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  school              School?                        @relation(fields: [schoolId], references: [id])
  teacher             Teacher?                       @relation(fields: [teacherId], references: [id])
  unit                Unit?                          @relation(fields: [unitId], references: [id])
  progress            LessonProgress[]
  quizzes             Quiz[]
  deliverySessions    TeacherLessonDeliverySession[]
  resourcesLinked     TeacherLessonResource[]
  teacherResources    TeacherResource[]
}

model LessonPlan {
  id                  String         @id @default(uuid())
  teacherId           String
  classId             String
  subjectId           String
  topicId             String?
  title               String         @default("Untitled Lesson Plan")
  objectives          String?        @db.Text
  competencies        String[]       @default([])
  crossCuttingIssues  String[]       @default([])
  teachingActivities  String?        @db.Text
  learningActivities  String?        @db.Text
  materialsNeeded     String[]       @default([])
  assessmentStrategy  String?        @db.Text
  homework            String?        @db.Text
  notes               String?        @db.Text
  duration            Int            @default(40)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  teacher             Teacher        @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  class               Class          @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject             Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  lessons             Lesson[]
}

model Activity {
  id           String        @id @default(uuid())
  lessonId     String?
  type         ActivityType
  title        String
  description  String?
  content      Json?
  order        Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  assignmentId String?       @unique
  courseId     String
  quizId       String?       @unique
  unitId       String?
  status       ContentStatus @default(PUBLISHED)
  assignment   Assignment?   @relation(fields: [assignmentId], references: [id])
  course       Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson       Lesson?       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  quiz         Quiz?         @relation(fields: [quizId], references: [id])
}

model LessonProgress {
  id          String       @id @default(uuid())
  studentId   String
  lessonId    String
  status      LessonStatus @default(NOT_STARTED)
  timeSpent   Int          @default(0)
  startedAt   DateTime?
  completedAt DateTime?
  deviceType  String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  lesson      Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  student     Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, lessonId])
}

model Assignment {
  id          String                 @id @default(uuid())
  courseId    String
  title       String
  description String?
  dueDate     DateTime?
  points      Int                    @default(100)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  lessonId    String?
  activity    Activity?
  course      Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson      Lesson?                @relation(fields: [lessonId], references: [id])
  submissions AssignmentSubmission[]
}

model AssignmentSubmission {
  id           String     @id @default(uuid())
  assignmentId String
  studentId    String
  content      String?
  attachments  String[]   @default([])
  status       String     @default("SUBMITTED")
  submittedAt  DateTime   @default(now())
  feedback     String?
  grade        Int?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
}

model Quiz {
  id                 String         @id @default(uuid())
  courseId           String
  title              String
  passMark           Int            @default(70)
  attemptsAllowed    Int            @default(3)
  timeLimit          Int?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  assignedAt         DateTime?
  averageScore       Int            @default(0)
  classId            String?
  completionRate     Int            @default(0)
  dueAt              DateTime?
  lessonId           String?
  randomizeQuestions Boolean        @default(false)
  schoolId           String?
  showResults        Boolean        @default(true)
  teacherId          String?
  topic              String?
  status             ContentStatus  @default(DRAFT)
  aiMessages         AIMessage[]
  activity           Activity?
  class              Class?         @relation(fields: [classId], references: [id])
  course             Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson             Lesson?        @relation(fields: [lessonId], references: [id])
  school             School?        @relation(fields: [schoolId], references: [id])
  teacher            Teacher?       @relation(fields: [teacherId], references: [id])
  attempts           QuizAttempt[]
  questions          QuizQuestion[]
}

model QuizQuestion {
  id           String       @id @default(uuid())
  quizId       String
  questionText String
  type         QuestionType
  options      Json
  answer       Json
  hint         String?
  explanation  String?
  order        Int
  createdAt    DateTime     @default(now())
  points       Int          @default(1)
  status       RecordStatus @default(ACTIVE)
  updatedAt    DateTime     @default(now()) @updatedAt
  answers      QuizAnswer[]
  quiz         Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
}

model QuizAttempt {
  id          String            @id @default(uuid())
  studentId   String
  quizId      String
  score       Int
  timeUsed    Int?
  status      QuizAttemptStatus @default(SUBMITTED)
  submittedAt DateTime          @default(now())
  answers     QuizAnswer[]
  quiz        Quiz              @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student     Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model QuizAnswer {
  id             String       @id @default(uuid())
  attemptId      String
  questionId     String
  selectedAnswer Json
  isCorrect      Boolean
  attempt        QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question       QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model Goal {
  id        String     @id @default(uuid())
  studentId String
  type      GoalType
  target    Int
  progress  Int        @default(0)
  dueDate   DateTime?
  status    GoalStatus @default(ACTIVE)
  student   Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Badge {
  id           String         @id @default(uuid())
  name         String         @unique
  criteria     String
  icon         String
  rewardPoints Int            @default(0)
  students     StudentBadge[]
}

model StudentBadge {
  id             String   @id @default(uuid())
  studentId      String
  badgeId        String
  earnedAt       DateTime @default(now())
  sourceActivity String
  badge          Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, badgeId])
}

model LibraryResource {
  id           String              @id @default(uuid())
  title        String
  type         LibraryResourceType
  levelId      String
  subjectId    String?
  fileUrl      String
  language     String              @default("en")
  description  String
  downloadable Boolean             @default(false)
  level        Level               @relation(fields: [levelId], references: [id], onDelete: Cascade)
  subject      Subject?            @relation(fields: [subjectId], references: [id])
}

model Message {
  id            String    @id @default(uuid())
  threadId      String
  senderId      String
  recipientId   String
  senderRole    UserRole
  recipientRole UserRole
  body          String
  readAt        DateTime?
  createdAt     DateTime  @default(now())
  recipient     User      @relation("ReceivedMessages", fields: [recipientId], references: [id], onDelete: Cascade)
  sender        User      @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  title     String
  body      String
  type      NotificationType
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Certificate {
  id             String   @id @default(uuid())
  studentId      String
  courseId       String
  certificateUrl String
  issuedAt       DateTime @default(now())
  course         Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model AIConversation {
  id        String      @id @default(uuid())
  studentId String
  title     String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  student   Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  messages  AIMessage[]
}

model AIMessage {
  id             String              @id @default(uuid())
  conversationId String
  role           AIMessageRole
  content        String
  sourceType     AIMessageSourceType @default(CHAT)
  lessonId       String?
  quizId         String?
  createdAt      DateTime            @default(now())
  conversation   AIConversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  lesson         Lesson?             @relation(fields: [lessonId], references: [id])
  quiz           Quiz?               @relation(fields: [quizId], references: [id])
}

model AIUsageLog {
  id           String   @id @default(uuid())
  userId       String
  feature      String
  model        String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  costEstimate Float    @default(0)
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Permission {
  id          String   @id @default(uuid())
  key         String   @unique
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AcademicYear {
  id                String             @id @default(uuid())
  schoolId          String
  name              String
  startDate         DateTime
  endDate           DateTime
  status            RecordStatus       @default(ACTIVE)
  createdById       String?
  updatedById       String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  school            School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  attendanceRecords AttendanceRecord[]
  terms             Term[]
  marks             Mark[]
  markSubmissions   MarkSubmission[]
  reportCards       ReportCard[]
  timetablePeriods  TimetablePeriod[]
  teacherWorkloads  TeacherWorkload[]
  nationalExamRegistrations NationalExamRegistration[]

  @@unique([schoolId, name])
}

model Term {
  id                String             @id @default(uuid())
  schoolId          String
  academicYearId    String
  name              String
  startDate         DateTime
  endDate           DateTime
  status            RecordStatus       @default(ACTIVE)
  createdById       String?
  updatedById       String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  attendanceRecords AttendanceRecord[]
  academicYear      AcademicYear       @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  marks             Mark[]
