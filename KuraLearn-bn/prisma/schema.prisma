model GradingScale {
  id            String   @id @default(uuid())
  schoolId      String
  minPercentage Float
  maxPercentage Float
  grade         String
  description   String?
  points        Int?
  remarks       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  school        School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, grade])
}

model Mark {
  id                  String             @id @default(uuid())
  submissionId        String?
  studentId           String
  teacherId           String
  schoolId            String
  classId             String
  subjectId           String
  academicYearId      String
  termId              String
  assessmentType      String             // e.g. HOMEWORK, EXAM, CAT
  assessmentKey       String             @default("type:CAT")
  score               Float?
  maxScore            Float
  percentage          Float?
  grade               String?
  rank                Int?
  missingReason       String?
  teacherComments     String?
  headteacherComments String?
  status              String             @default("DRAFT") // DRAFT, SUBMITTED, APPROVED
  isLocked            Boolean            @default(false)
  submittedAt         DateTime?
  reviewedById        String?
  reviewedAt          DateTime?
  reviewComment       String?
  approvedAt          DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  
  submission          MarkSubmission?    @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  student             Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher             Teacher            @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  school              School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class               Class              @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject             Subject            @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  academicYear        AcademicYear       @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  term                Term               @relation(fields: [termId], references: [id], onDelete: Cascade)
  reviewedBy          User?              @relation("MarkReviewer", fields: [reviewedById], references: [id])
  auditLogs           MarkAuditLog[]

  @@unique([studentId, termId, subjectId, assessmentKey])
  @@index([submissionId])
  @@index([schoolId, status])
  @@index([classId, subjectId, termId])
}

model MarkSubmission {
  id             String               @id @default(uuid())
  schoolId       String
  classId        String
  subjectId      String
  academicYearId String
  termId         String
  teacherId      String
  assessmentType String
  assessmentKey  String
  maxScore       Float                @default(100)
  status         MarkSubmissionStatus @default(DRAFT)
  isLocked       Boolean              @default(false)
  submittedAt    DateTime?
  reviewedById   String?
  reviewedAt     DateTime?
  reviewComment  String?
  createdById    String?
  updatedById    String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  school         School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class          Class                @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject        Subject              @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear         @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  term           Term                 @relation(fields: [termId], references: [id], onDelete: Cascade)
  teacher        Teacher              @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  reviewedBy     User?                @relation("MarkSubmissionReviewer", fields: [reviewedById], references: [id])
  marks          Mark[]
  events         MarkSubmissionEvent[]

  @@unique([schoolId, classId, subjectId, termId, assessmentKey])
  @@index([schoolId, status])
  @@index([teacherId, status])
  @@index([classId, subjectId, termId])
}

model MarkSubmissionEvent {
  id           String                @id @default(uuid())
  submissionId String
  actorId      String?
  action       String
  fromStatus   MarkSubmissionStatus?
  toStatus     MarkSubmissionStatus?
  comment      String?
  metadata     Json?
  createdAt    DateTime              @default(now())

  submission   MarkSubmission         @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  actor        User?                  @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([submissionId, createdAt])
  @@index([actorId])
}

model MarkAuditLog {
  id          String   @id @default(uuid())
  markId      String
  changedById String
  action      String   @default("SCORE_UPDATE")
  oldScore    Float?
  newScore    Float?
  oldValue    Json?
  newValue    Json?
  reason      String
  createdAt   DateTime @default(now())
  mark        Mark     @relation(fields: [markId], references: [id], onDelete: Cascade)
  changedBy   User     @relation(fields: [changedById], references: [id], onDelete: Cascade)
}

model ReportCard {
  id                      String   @id @default(uuid())
  studentId               String
  classId                 String
  academicYearId          String
  termId                  String
  totalMarks              Float?
  averagePercentage       Float?
  grade                   String?
  classRank               Int?
  attendanceSummary       String?
  teacherComments         String?
  headteacherComments     String?
  promotionRecommendation String?  // e.g. PROMOTED, REPEATED
  status                  String   @default("DRAFT") // DRAFT, REVIEW, APPROVED, LOCKED
  approvedById            String?
  approvedAt              DateTime?
  verificationCode        String?  @unique
  pdfUrl                  String?
  pdfGeneratedAt          DateTime?
  attendanceData          Json?
  reportData              Json?
  aiInsights              Json?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  student                 Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class                   Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  academicYear            AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  term                    Term         @relation(fields: [termId], references: [id], onDelete: Cascade)
  approvedBy              User?        @relation("ReportCardApprover", fields: [approvedById], references: [id])

  @@unique([studentId, termId])
}

model ReportComment {
  id             String   @id @default(uuid())
  studentId      String
  academicYearId String
  termId         String
  commentText    String
  commentType    String   // e.g. TEACHER, HEADTEACHER
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([studentId, termId, commentType])
}

model ReportGenerationLog {
  id             String   @id @default(uuid())
  schoolId       String
  classId        String
  academicYearId String
  termId         String
  generatedById  String
  format         String   // e.g. PDF, EXCEL
  status         String
  createdAt      DateTime @default(now())
}
